# --- BillBuddy configuration (copy to .env and fill in) ---

# Server port
PORT=3000

# Public base URL of this app (used for PayPal return/cancel URLs).
# For local use: http://localhost:3000
BASE_URL=http://localhost:3000

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# If left empty, /api/extract falls back to a clearly-labelled demo parser.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash).
GEMINI_MODEL=

# PayPal Sandbox app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# If left empty, /api/pay returns a clearly-labelled SIMULATED payment.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal environment: sandbox | live  (this hackathon demo uses sandbox)
PAYPAL_ENV=sandbox

# Demo FX rate for settling INR bills in USD: 1 USD = this many INR.
# PayPal sandbox checkout does not support INR (CURRENCY_NOT_SUPPORTED),
# so BillBuddy converts INR bills to USD at this rate for the sandbox
# payment and records both amounts in the ledger.
DEMO_FX_INR_PER_USD=83
